# All values are optional. Nothing here is a secret; anything prefixed VITE_ is
# compiled into the public bundle.

# Set to 1 to expose the dev-only live preview (?mode=live-preview) in a built site.
# Leave unset for production builds.
VITE_ALLOW_LIVE_PREVIEW=

# Privacy-conscious analytics slot. Nothing loads unless all three are set.
# Provider: plausible | umami
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_SCRIPT_URL=
VITE_ANALYTICS_SITE_ID=

# WalletConnect / Reown project id. Free and public, not a credential to protect.
# Create a project at https://cloud.reown.com, copy the Project ID and paste it here.
# While it is empty the connect sheet still lists WalletConnect, disabled, labelled
# "Mobile wallets: available soon", and the WalletConnect bundle is never loaded.
VITE_WALLETCONNECT_PROJECT_ID=
